# Variables the analyzer can read. It never loads this file itself: export the ones you use
# in your shell (or load them with your own tool). Never commit real keys.
# LLM stages are optional; the analyzer works without any of these. A custom variable name
# can be used instead with [llm.connection] api_key_env = "MY_VARIABLE".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Key for an OpenAI-compatible server (for example a local model server), if it requires one.
OPENAI_COMPAT_API_KEY=

# Interface language: en (default) or pt-BR.
WCA_LANG=en
