# Copy to .env and fill in only the providers you use. Never commit .env.
# LLM stages are optional; the analyzer works without any of these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Key for an OpenAI-compatible server (for example a local model server), if it requires one.
OPENAI_COMPAT_API_KEY=

# Interface language: en (default) or pt-BR.
WCA_LANG=en
